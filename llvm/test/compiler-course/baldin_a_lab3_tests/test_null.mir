callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    liveins: $rdi, $esi
    
    ; CHECK: %1:gr32 = COPY $esi
    ; CHECK-NEXT: %0:gr64 = COPY $rdi
    ; CHECK-NEXT: $rdi = COPY %0
    ; CHECK-NEXT: CALL64pcrel32 &check_null, implicit $rsp, implicit $ssp
    ; CHECK-NEXT: MOV32mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.p, !tbaa !5)
    ; CHECK-NEXT: RET 0

    %1:gr32 = COPY $esi
    %0:gr64 = COPY $rdi
    MOV32mr %0, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.p, !tbaa !5)
    RET 0
...
